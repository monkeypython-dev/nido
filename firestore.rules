rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo la cuenta compartida de la pareja puede leer y escribir.
    match /households/nido/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'juliosorianosalido@gmail.com';
    }
  }
}
